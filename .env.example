# ─── Auth (admin panel) ───────────────────────────────────
# Long random string — generate with: openssl rand -hex 32
ADMIN_COOKIE_SECRET=

# Admin login password (plain text, hashed on verify)
ADMIN_PASSWORD=

# ─── Contact Form (Resend) ────────────────────────────────
# Get your API key at https://resend.com/api-keys
RESEND_API_KEY=

# Recipient address for contact form submissions
CONTACT_EMAIL=ramlakshmanrishikesh@gmail.com

# "From" address (must be a verified Resend domain)
CONTACT_FROM=CloudSwift Contact <noreply@oncloudswift.com>

